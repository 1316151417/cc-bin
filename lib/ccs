#!/usr/bin/env zsh

set -euo pipefail

TARGET_FILE="$HOME/.claude/settings.json"

source "${0:A:h}/providers.zsh"

case "${1:-}" in
  --list) list_providers; exit 0 ;;
  --help|-h)
    echo "Usage: ccs <${(j:|:)provider_order}> | --list"
    exit 0 ;;
esac
load_provider "${1:-}"

umask 077
if [[ -d "$TARGET_FILE" || -d "${TARGET_FILE}.bak" ]]; then
  print -u2 -- 'Settings or backup path is a directory; no configuration was changed.'
  exit 1
fi
mkdir -p "${TARGET_FILE:h}"
temporary_file=$(mktemp "${TARGET_FILE}.tmp.XXXXXX")
trap 'rm -f -- "$temporary_file"' EXIT

render_provider_settings > "$temporary_file"

if [[ -f "$TARGET_FILE" ]]; then
  cp "$TARGET_FILE" "${TARGET_FILE}.bak"
  chmod 600 "${TARGET_FILE}.bak"
fi
mv -f -- "$temporary_file" "$TARGET_FILE"

echo "Switched to $sonnet/$opus/$haiku"
